# ============================================================
# ShockWAVE / IceStoRM kernel build env  (mt6768: lancelot / merlin)
# xxKSU preset = same settings the ShockWAVE author uses for this 17.0 tree.
# Every key appears exactly ONCE (the workflow uses the last value if a key is repeated).
# ============================================================

# ---- Base ----
KERNEL_SOURCE=https://github.com/suman-1007-cyber/FinELikEWinE-MT6768-KerneL_69
KERNEL_SOURCE_BRANCH=FinELikEWinE_69
KERNEL_ARCH=arm64
KERNEL_IMAGE_NAME=Image.gz-dtb

# Real defconfig + per-device fragments (paths are relative to arch/arm64/configs)
KERNEL_CONFIG_BASE=vendor/mt6768_defconfig
# Comma-separated device list; each one builds vendor/<device>.config on top of the base
DEVICES=lancelot
KERNEL_CONFIG_FRAGMENT_DIR=vendor

# ---- KernelSU (xxKSU driver, from the author's config-xxksu.env) ----
ENABLE_KERNELSU=true
KERNELSU_SETUP_SOURCE=https://raw.githubusercontent.com/MrShockWAVEog/KernelSU/shockwave/kernel/setup.sh
KERNELSU_TAG=shockwave
ADD_KPROBES_CONFIG=false
KSU_HOOKS_PATCH=false
KSU_REVERT=false
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
# Fallbacks (use via the "Run workflow" override boxes, not here):
#   KernelSU-Next legacy: setup=https://raw.githubusercontent.com/KernelSU-Next/KernelSU-Next/next/kernel/setup.sh  tag=legacy
#   KernelSU-Next fork:   setup=https://raw.githubusercontent.com/MrShockWAVEog/KernelSU-Next/shockwave/kernel/setup.sh  tag=shockwave

# ---- APatch ----
ADD_APATCH_SUPPORT=false
FIX_APATCH_OPENELA=false

# ---- Compiler (author's toolchain: AOSP clang, no GCC) ----
USE_CLANG=true
CLANG_SOURCE=https://github.com/MrShockWAVEog/Google-Clang-Mirror/releases/download/clang-r614150-aosp/clang.tar.gz
CLANG_BRANCH=
USE_GCC=false
USE_GCC_64=false
GCC_64_SOURCE=
GCC_64_BRANCH=
USE_GCC_32=false
GCC_32_SOURCE=
GCC_32_BRANCH=
# Previous Neutron clang, if you ever want it back:
# CLANG_SOURCE=https://github.com/Neutron-Toolchains/clang-build-catalogue/releases/download/30072026/neutron-clang-30072026.tar.zst

# ---- AnyKernel3 ----
USE_ANYKERNEL3=true
ANYKERNEL3_SOURCE=https://github.com/MrShockWAVEog/AnyKernel3.git
ANYKERNEL3_BRANCH=shockwave

# ---- Build ----
EXTRA_CMDS=LLVM=1 LLVM_IAS=1 CROSS_COMPILE=aarch64-linux-gnu- CROSS_COMPILE_ARM32=arm-linux-gnueabi- CROSS_COMPILE_COMPAT=arm-linux-gnueabi- CONFIG_NO_ERROR_ON_MISMATCH=y TARGET_BUILD_VARIANT=user
LOCALVERSION=-IceStoRM
DISABLE_LTO=
DISABLE_CC_WERROR=true
ENABLE_PYTHON2=false
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/xiaoleGun/KernelSU_action/main/boot/boot.img

# ---- Misc ----
ADD_OVERLAYFS_CONFIG=false

# ---- Proton specific ----
FIX_WIFI_SPEED=true

# ---- KPM ----
KPM_SUPPORT=false
KPM_URL=https://github.com/SukiSU-Ultra/SukiSU_KernelPatch_patch/releases/download/0.12.2/patch_linux
