# ============================================================
# ShockWAVE / IceStoRM KernelSU-Next (ksun) build env  (mt6768: lancelot / merlin)
# Place this file in the ROOT of your kernel repo.
# NOTE: every key appears exactly ONCE (your old file had ENABLE_KERNELSU twice;
# the later "false" silently overrode "true").
# ============================================================

# ---- Base ----
# Empty KERNEL_SOURCE = build the repo this workflow lives in.
KERNEL_SOURCE=https://github.com/suman-1007-cyber/shockwave_kernel_xiaomi_mt6768
KERNEL_SOURCE_BRANCH=17.0
KERNEL_ARCH=arm64
KERNEL_IMAGE_NAME=Image.gz-dtb

# Real defconfig + per-device fragments (paths are relative to arch/arm64/configs)
KERNEL_CONFIG_BASE=vendor/mt6768_defconfig
# Comma-separated device list; each one builds vendor/<device>.config on top of the base
DEVICES=lancelot
KERNEL_CONFIG_FRAGMENT_DIR=vendor

# ---- KernelSU ----
ENABLE_KERNELSU=true
# Option A (ACTIVE): upstream KernelSU-Next, dev branch (current, actively maintained)
KERNELSU_SETUP_SOURCE=https://raw.githubusercontent.com/KernelSU-Next/KernelSU-Next/dev/kernel/setup.sh
KERNELSU_TAG=dev
# Option B (old fork that matches the SUSFS code already inside this kernel tree):
# KERNELSU_SETUP_SOURCE=https://raw.githubusercontent.com/MrShockWAVEog/KernelSU-Next/shockwave/kernel/setup.sh
# KERNELSU_TAG=shockwave
# Tree already has CONFIG_KSU_SUSFS + CONFIG_NOMOUNT in mt6768_defconfig, kprobes hooks are used
ADD_KPROBES_CONFIG=true
KSU_HOOKS_PATCH=false
KSU_REVERT=false
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# ---- APatch ----
ADD_APATCH_SUPPORT=false
FIX_APATCH_OPENELA=false

# ---- Compiler ----
USE_CLANG=true
CLANG_SOURCE=https://github.com/Neutron-Toolchains/clang-build-catalogue/releases/download/30072026/neutron-clang-30072026.tar.zst
CLANG_BRANCH=
# GCC is only used for the CROSS_COMPILE prefixes (binutils fallback); Clang does the compiling
USE_GCC=false
USE_GCC_64=true
GCC_64_SOURCE=https://snapshots.linaro.org/gnu-toolchain/14.0-2023.06-1/aarch64-linux-gnu/gcc-linaro-14.0.0-2023.06-x86_64_aarch64-linux-gnu.tar.xz
GCC_64_BRANCH=
USE_GCC_32=true
GCC_32_SOURCE=https://snapshots.linaro.org/gnu-toolchain/14.0-2023.06-1/arm-linux-gnueabihf/gcc-linaro-14.0.0-2023.06-x86_64_arm-linux-gnueabihf.tar.xz
GCC_32_BRANCH=

# ---- AnyKernel3 ----
USE_ANYKERNEL3=true
ANYKERNEL3_SOURCE=https://github.com/MrShockWAVEog/AnyKernel3.git
ANYKERNEL3_BRANCH=shockwave

# ---- Build ----
# $GCC64/$GCC32 are replaced by the workflow with the real toolchain prefix paths
EXTRA_CMDS=LLVM=1 LLVM_IAS=1 CROSS_COMPILE=aarch64-linux-gnu- CROSS_COMPILE_ARM32=arm-linux-gnueabi- CROSS_COMPILE_COMPAT=arm-linux-gnueabi- CONFIG_NO_ERROR_ON_MISMATCH=y TARGET_BUILD_VARIANT=user
LOCALVERSION=-Not_Human
DISABLE_LTO=
DISABLE_CC_WERROR=true
ENABLE_PYTHON2=false
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/xiaoleGun/KernelSU_action/main/boot/boot.img

# ---- Misc ----
ADD_OVERLAYFS_CONFIG=false

# ---- Proton specific ----
FIX_WIFI_SPEED=true

# ---- KPM ----
KPM_SUPPORT=false
KPM_URL=https://github.com/SukiSU-Ultra/SukiSU_KernelPatch_patch/releases/download/0.12.2/patch_linux
